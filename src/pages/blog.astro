---
import type { MarkdownInstance } from "astro";

import BlogPost from "../components/BlogPost.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const allPosts = Object.values(
  import.meta.glob<MarkdownInstance<{ pubDate: string; title: string }>>(
    "../pages/posts/*.{md,mdx}",
    { eager: true },
  ),
).sort(
  (a, b) =>
    new Date(b.frontmatter.pubDate).getTime() -
    new Date(a.frontmatter.pubDate).getTime(),
);
---

<BaseLayout title="Blog | Michael Yuen's website">
  <h1><span>my</span>Blog</h1>
  <p>This is where I will post about my journey.</p>
  <ul>
    {
      allPosts.map((post) => (
        <BlogPost title={post.frontmatter.title} url={post.url} />
      ))
    }
  </ul>
</BaseLayout>
